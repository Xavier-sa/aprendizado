DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Gere um valor aleatório (ex.: `openssl rand -base64 32`). Nunca reutilize
# o mesmo valor em produção e desenvolvimento.
BETTER_AUTH_SECRET="troque-por-um-valor-aleatorio-de-32-caracteres-ou-mais"

# URL pública onde a aplicação roda. Em produção, use a URL real (ex.:
# https://financebot.vercel.app).
BETTER_AUTH_URL="http://localhost:3000"
