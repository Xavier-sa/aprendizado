# Todos os endpoints usados por esta POC são públicos e não exigem chave
# (confirmado em docs/osiris-api-discovery.md, coluna "Autenticação").
# As variáveis abaixo existem para o caso de a própria OSIRIS mudar isso,
# ou para apontar para uma instância local da OSIRIS durante desenvolvimento.

# Base URL da API OSIRIS. Padrão: https://osirisai.live/api
OSIRIS_BASE_URL=https://osirisai.live/api

# Não é necessária para nenhum endpoint usado nesta POC hoje. Deixe em
# branco a menos que a OSIRIS passe a exigir chave para um destes feeds.
OSIRIS_API_KEY=
